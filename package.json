{
  "name": "any2u1",
  "version": "0.1.0",
  "private": true,
  "description": "A browser extension that turns a 3MF from Bambu Studio, Creality Print, Anycubic Slicer Next, ElegooSlicer or Flash Studio into a Snapmaker U1 file, entirely on your device.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "any2orca": "0.3.1",
    "any2orca-profiles": "0.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "24.13.3",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
